{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demir-kit.dev/schemas/role-matrix.schema.json",
  "title": "demir-kit role capability matrix (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "roles"],
  "properties": {
    "version": { "const": 1 },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "mission", "default_level", "capabilities", "focus", "evidence"],
        "properties": {
          "class": { "enum": ["product", "design", "build", "verify", "operate", "market", "lead"] },
          "mission": { "type": "string", "minLength": 20 },
          "default_level": { "enum": ["aware", "practitioner", "expert"] },
          "capabilities": {
            "type": "object",
            "additionalProperties": { "enum": ["aware", "practitioner", "expert"] }
          },
          "focus": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
        }
      }
    }
  }
}
