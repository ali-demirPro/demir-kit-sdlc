{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demir-kit.dev/schemas/evidence.schema.json",
  "title": "demir-kit checkpoint evidence (v2)",
  "description": "One evidence comment per checkpoint. A leaf cannot be leaf-done without these.",
  "type": "object",
  "additionalProperties": false,
  "required": ["demir_kit_version", "cp_id", "issue", "behavior", "reviews", "tests", "status"],
  "properties": {
    "demir_kit_version": { "const": "2" },
    "cp_id": { "type": "string", "pattern": "^CP-[0-9]+$" },
    "issue": { "type": "integer", "minimum": 1 },
    "agent": { "type": "string", "minLength": 2 },
    "commit": { "type": "string" },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "checkpoint": { "type": "string" }
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architect": { "enum": ["approved", "revise_required", "skipped"] },
        "commercial": { "enum": ["approved", "revise_required", "skipped"] },
        "ui": { "enum": ["pass", "invalid", "skipped"] },
        "ui_visual": { "enum": ["pass", "fail", "skipped"] },
        "ui_interaction": { "enum": ["pass", "fail", "skipped"] },
        "comparison_valid": { "type": "boolean" },
        "platform": { "enum": ["pass", "fail", "skipped"] },
        "adversarial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer_a"],
          "properties": {
            "reviewer_a": { "enum": ["approved", "revise_required", "skipped"] },
            "reviewer_b": { "enum": ["approved", "revise_required", "skipped"] }
          }
        },
        "human": { "enum": ["approved", "revise_required", "skipped"] },
        "human_second": { "enum": ["approved", "revise_required", "skipped"] },
        "risk": { "enum": ["low", "medium", "high", "critical"] }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "task_id", "dispatch_id", "agent", "outcome"],
      "properties": {
        "run_id": { "type": "string", "minLength": 3 },
        "task_id": { "type": "string", "minLength": 3 },
        "dispatch_id": { "type": "string", "minLength": 3 },
        "agent": { "type": "string", "minLength": 2 },
        "outcome": { "enum": ["succeeded", "failed"] }
      }
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "task_id", "dispatch_id", "agent", "outcome"],
        "properties": {
          "run_id": { "type": "string", "minLength": 3 },
          "task_id": { "type": "string", "minLength": 3 },
          "dispatch_id": { "type": "string", "minLength": 3 },
          "agent": { "type": "string", "minLength": 2 },
          "outcome": { "enum": ["succeeded", "failed"] }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "result"],
        "properties": {
          "case": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "skip"] },
          "note": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["open", "fixed", "waived"] },
          "note": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "diff_hash", "ci", "reviewers"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "diff_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "ci": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["success", "skipped"] },
            "run_id": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 5 }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "success" } }, "required": ["status"] },
              "then": { "required": ["run_id"] }
            },
            {
              "if": { "properties": { "status": { "const": "skipped" } }, "required": ["status"] },
              "then": { "required": ["reason"] }
            }
          ]
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "id", "model", "prompt_hash", "diff_hash"],
            "properties": {
              "role": { "type": "string", "minLength": 2 },
              "id": { "type": "string", "minLength": 3 },
              "model": { "type": "string", "minLength": 3 },
              "prompt_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "diff_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "status": { "enum": ["pass", "fail"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } }, "required": ["status"] },
      "then": {
        "properties": {
          "behavior": {
            "properties": { "exit_code": { "const": 0 } }
          },
          "tests": {
            "items": {
              "properties": { "result": { "const": "pass" } }
            }
          }
        }
      }
    }
  ]
}
