{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demir-kit.dev/schemas/epic.schema.json",
  "title": "demir-kit epic scope (v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["demir_kit_version", "summary", "scope_triage", "children"],
  "properties": {
    "demir_kit_version": { "const": "2" },
    "summary": { "type": "string", "minLength": 20 },
    "scope_triage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keep", "defer", "cut"],
      "properties": {
        "keep": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scope_item" } },
        "defer": { "type": "array", "items": { "$ref": "#/$defs/scope_item" } },
        "cut": { "type": "array", "items": { "$ref": "#/$defs/scope_item" } }
      }
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "decisions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "scope_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item"],
      "properties": {
        "item": { "type": "string", "minLength": 5 },
        "issue": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
