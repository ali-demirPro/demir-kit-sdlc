{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demir-kit.dev/schemas/capability.schema.json",
  "title": "demir-kit capability registry (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "levels", "risk_requirements", "capabilities"],
  "properties": {
    "version": { "const": 1 },
    "levels": {
      "type": "array",
      "minItems": 4,
      "items": { "enum": ["aware", "practitioner", "expert", "authority"] }
    },
    "risk_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "medium", "high", "critical"],
      "properties": {
        "low": { "$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "additionalProperties": false, "required": ["minimum", "approvers", "human_gate", "human_count"], "properties": { "minimum": { "enum": ["aware", "practitioner", "expert"] }, "approvers": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "human_gate": { "enum": ["none", "exhaustion", "leaf", "always"] }, "human_count": { "type": "integer", "minimum": 0 } } },
        "medium": { "type": "object", "additionalProperties": false, "required": ["minimum", "approvers", "human_gate", "human_count"], "properties": { "minimum": { "enum": ["aware", "practitioner", "expert"] }, "approvers": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "human_gate": { "enum": ["none", "exhaustion", "leaf", "always"] }, "human_count": { "type": "integer", "minimum": 0 } } },
        "high": { "type": "object", "additionalProperties": false, "required": ["minimum", "approvers", "human_gate", "human_count"], "properties": { "minimum": { "enum": ["aware", "practitioner", "expert"] }, "approvers": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "human_gate": { "enum": ["none", "exhaustion", "leaf", "always"] }, "human_count": { "type": "integer", "minimum": 0 } } },
        "critical": { "type": "object", "additionalProperties": false, "required": ["minimum", "approvers", "human_gate", "human_count"], "properties": { "minimum": { "enum": ["aware", "practitioner", "expert"] }, "approvers": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "human_gate": { "enum": ["none", "exhaustion", "leaf", "always"] }, "human_count": { "type": "integer", "minimum": 0 } } }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "label", "description", "match", "roles", "packs", "risk_floor", "gates", "evidence"],
        "properties": {
          "kind": { "enum": ["platform", "domain", "distribution", "quality"] },
          "label": { "type": "string", "minLength": 2 },
          "description": { "type": "string", "minLength": 20 },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "platforms": { "type": "array", "items": { "type": "string" } },
              "stacks": { "type": "array", "items": { "type": "string" } },
              "surfaces": { "type": "array", "items": { "type": "string" } },
              "distribution": { "type": "array", "items": { "type": "string" } },
              "keywords": { "type": "array", "items": { "type": "string" } }
            }
          },
          "roles": {
            "type": "object",
            "additionalProperties": { "enum": ["aware", "practitioner", "expert"] }
          },
          "packs": { "type": "array", "items": { "type": "string" } },
          "risk_floor": { "enum": ["low", "medium", "high", "critical"] },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["behavior", "architect", "commercial", "ui", "platform", "human"] }
          },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
        }
      }
    }
  }
}
